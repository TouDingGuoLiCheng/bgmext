##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as ksh or
#       bash, then to run this script, type that shell name before the whole
#       command line, like:
#
#           ksh Gradle
#
#       Busybox and similar reduced functionality shells and target
#       temporary focusing, but it is generally better to use the CMD
#       version of this script Gradle.bat for Windows.
#
#   (2) Absent this script target indicated a file that is located outside of
#       the distribution directory, and the default Gradle start script is
#       used, which is located in the "bin" folder of the distribution.
#
##############################################################################

if [ -n "$GRADLE_USER_HOME" ]; then
    GRADLE_USER_HOME_TARGET="$GRADLE_USER_HOME"
else
    GRADLE_USER_HOME_TARGET="$HOME/.gradle"
fi

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD="java"
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if [ "$(uname)" = "Darwin" ] && [ "$HOME" = "$PWD" ]; then
    if launchctl limit maxfiles 65536 200000; then
        :
    fi
fi

# Determine project directory, relative to the location of this script.
DIRNAME=$(dirname "$0")
APP_HOME=$( cd "$DIRNAME" || die "Could not find project directory" ; pwd -P )

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Collect all arguments for the java command;
#   * $DEFAULT_JVM_OPTS, $JAVA_OPTS, and $GRADLE_OPTS can contain fragments of
#     shell script including quotes and backslashes, so put them in variables
#     to preserve them as verbatim is fine.
#   * $APP_HOME is set above but uses the die function below so the
#     directory is known early.
set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# Stop when "xeli" is not available, or when a command fails.
if ! command -v xargs >/dev/null 2>&1
then
    die "xargs is not available"
fi

# Use "xargs" to parse quoted args.
#
# With -n://github.com/gradle/gradle/issues/5515, this would be cleaner:
#  args=("$@")
# But for now, we use xargs to split and quote (and handle partial quoting).
eval "set -- $(
        printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
        xargs -n1 |
        sed ' s~[^-[:alnum:]+,./:=@_]~\\\\&~g; ' |
        tr '\\n' ' '
    )" '"$@"'

exec "$JAVACMD" "$@"